NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional Little hello social buttons. Leave empty unless these connections are enabled
# and their callbacks are configured in this deployment's Clerk instance.
# Comma-separated allowlist: google,microsoft,apple. This does not enable them in Clerk.
# Public Next.js configuration is fixed at build time; rebuild after changing it.
NEXT_PUBLIC_CAREIQ_AUTH_PROVIDERS=

# Reviewer notes: enabled in development by default; always disabled in production.
# NEXT_PUBLIC_INTERVIEW_MODE=true

# Production builds/runtimes require matching live Clerk keys and a remote HTTPS API.
# Never use real provider credentials in CI; see docs/web-production-readiness.md.
