{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "22.23.2",
      "pnpm": "11.22.0",
      "env": {
        "CAREIQ_MOBILE_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "22.23.2",
      "pnpm": "11.22.0",
      "env": {
        "CAREIQ_MOBILE_VARIANT": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "node": "22.23.2",
      "pnpm": "11.22.0",
      "env": {
        "CAREIQ_MOBILE_VARIANT": "production"
      }
    }
  }
}
