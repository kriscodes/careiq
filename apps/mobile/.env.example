# Public build inputs only. Leave blank to run the setup shell without services.
# Use an HTTPS origin (no /api/v1 path). Local HTTP works only in development
# and may also need native platform transport configuration; prefer HTTPS.
EXPO_PUBLIC_API_URL=
# The same environment's Clerk publishable key; never a Clerk secret key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
