{
  "expo": {
    "name": "CareIQ Mobile",
    "slug": "careiq-mobile",
    "version": "0.1.0",
    "scheme": "careiq-dev",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.careiq.mobile"
    },
    "android": {
      "package": "dev.careiq.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "expo-sharing"
    ],
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
