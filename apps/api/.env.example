DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
PORT=3000
# Exact product origins: also used as Clerk authorized parties. Preserve hosted WEB origin.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Explicitly enable only after the marketing migration, runtime grants and
# privacy/contact launch requirements have been verified.
INTERVIEW_REQUESTS_ENABLED=false
# Leave blank locally. Set only verified hosting proxy IPs/CIDRs; never true or
# a hop count. With no trust, requests behind one proxy share an IP quota.
TRUSTED_PROXY_CIDRS=
# verify-full for external/hosted endpoints with trusted certificates (default).
# require for Render INTERNAL PostgreSQL URLs (encrypted; self-signed certificate).
# disable for local PostgreSQL without TLS.
# Render: https://render.com/docs/postgresql-creating-connecting#ssl-modes-for-internal-connections
DATABASE_SSL_MODE=verify-full

# Remove SSL/certificate query parameters from DATABASE_URL; use DATABASE_SSL_MODE.

# Approve founding Clerk user IDs explicitly; empty disables practice creation.
CAREIQ_PRACTICE_CREATOR_USER_IDS=

# Additional reviewed Clerk role keys; configure explicit clinical permissions in Clerk.
CAREIQ_STAFF_ROLES=

# Optional fixed trusted web URL for staff invitation redirects.
CAREIQ_INVITATION_REDIRECT_URL=

# Signed membership reconciliation endpoint: POST /api/v1/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Explicitly enable only after verified native session/device acceptance.
CLERK_NATIVE_AUTH_ENABLED=false

# Exact additional native JWT azp HTTP(S) origins, if present; never callback URLs or wildcards.
CLERK_NATIVE_AUTHORIZED_PARTIES=

# Optional bind address; defaults to 127.0.0.1 outside production and 0.0.0.0 in production.
HOST=

# Production startup verifies live Clerk keys, signed webhooks, HTTPS origins and
# invitation redirects, encrypted DB transport and restricted DB/RLS release state.
# Keep migration/operator credentials separate from the API runtime credential.
# Non-loopback migration: db:migrate --confirm-database <reviewed-db-name>.

# Per API process. Budget the sum across every API replica and worker below DB capacity.
DATABASE_POOL_MAX=10
DATABASE_POOL_MAX_WAITING=40
DATABASE_POOL_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Required in production: pre-provision an owner-only (0700) private volume
# outside this application checkout. Never point this at public/static output.
# Existing files must be owner-only (0600), regular and unlinked.
CAREIQ_PRIVATE_STORAGE_DIR=
# Generate at least 32 random bytes as hexadecimal in the secret manager.
# Use the same reviewed key across the API fleet; never commit its value.
CAREIQ_WORKFLOW_CURSOR_SECRET=
# Optional scanner executable; missing/unavailable keeps uploads quarantined.
CAREIQ_SCANNER_COMMAND=

# Optional separate restricted audit-reader login; never reuse runtime/owner.
# When configured in production, provision a separate private export directory
# and a distinct random cursor key with the same custody requirements above.
CAREIQ_AUDIT_DATABASE_URL=
CAREIQ_AUDIT_SSL_MODE=verify-full
CAREIQ_AUDIT_EXPORT_DIR=
CAREIQ_AUDIT_CURSOR_SECRET=

# Patient delivery/staff notifications: remain disabled until reviewed activation.
# See docs/notifications-implementation.md for enrollment, sender and callback setup.
CAREIQ_DELIVERY_ENABLED=false
CAREIQ_DELIVERY_FINGERPRINT_KEY=
CAREIQ_DELIVERY_PAYLOAD_KEY=
CAREIQ_DELIVERY_PUBLIC_ORIGIN=
CAREIQ_DELIVERY_CALLBACK_ROUTE_KEY=
CAREIQ_RESEND_API_KEY=
CAREIQ_RESEND_FROM=
CAREIQ_RESEND_ACCOUNT=
CAREIQ_RESEND_WEBHOOK_SECRET=
CAREIQ_RESEND_PREVIOUS_WEBHOOK_SECRET=
# Optional public HTTPS asset base ending in /; text wordmark/plus fallback when blank.
# Example: https://YOUR-APP/brand/little-hello/
CAREIQ_EMAIL_ASSET_BASE_URL=
CAREIQ_TWILIO_ACCOUNT_SID=
CAREIQ_TWILIO_AUTH_TOKEN=
CAREIQ_TWILIO_PREVIOUS_AUTH_TOKEN=
CAREIQ_TWILIO_FROM=
CAREIQ_TWILIO_CALLBACK_URL=
CAREIQ_TWILIO_INBOUND_URL=
CAREIQ_SMS_FOOTER=
CAREIQ_STAFF_APP_URL=
CAREIQ_NOTIFICATION_WORKER_ENABLED=false
CAREIQ_NOTIFICATION_WORKER_INTERVAL_MS=30000
# Explicit current principal tuples; required for callbacks even with worker paused.
CAREIQ_NOTIFICATION_WORKER_SCOPES=
