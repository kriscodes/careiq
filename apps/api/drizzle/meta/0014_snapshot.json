        "marketing_interview_requests_name_nonempty": {
          "name": "marketing_interview_requests_name_nonempty",
          "value": "length(btrim(\"marketing_interview_requests\".\"name\")) > 0"
        },
        "marketing_interview_requests_email_nonempty": {
          "name": "marketing_interview_requests_email_nonempty",
