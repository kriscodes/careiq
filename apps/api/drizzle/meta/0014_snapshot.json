        "marketing_interview_requests_role_valid": {
          "name": "marketing_interview_requests_role_valid",
          "value": "\"marketing_interview_requests\".\"role\" IN ('practice_owner', 'practice_manager', 'administrative_staff', 'provider', 'other')"
        },
        "marketing_interview_requests_source_valid": {
          "name": "marketing_interview_requests_source_valid",
          "value": "\"marketing_interview_requests\".\"source\" = 'marketing_homepage'"
        },
        "marketing_interview_requests_notice_nonempty": {
          "name": "marketing_interview_requests_notice_nonempty",
          "value": "length(btrim(\"marketing_interview_requests\".\"privacy_notice_version\")) > 0"
        },
        "marketing_interview_requests_key_v4": {
          "name": "marketing_interview_requests_key_v4",
          "value": "substring(\"marketing_interview_requests\".\"submission_key\"::text from 15 for 1) = '4' AND substring(\"marketing_interview_requests\".\"submission_key\"::text from 20 for 1) IN ('8', '9', 'a', 'b')"
        }
