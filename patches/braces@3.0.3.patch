diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,22 @@
+'use strict';
+
+// Parsed patterns are bounded separately. Validate caller-supplied ASTs without
+// recursion so compile/expand/stringify cannot bypass the nesting limit.
+module.exports = input => {
+  const pending = [{ node: input, depth: 0 }];
+  let visited = 0;
+  while (pending.length > 0) {
+    const { node, depth } = pending.pop();
+    if (depth > 128 || ++visited > 20000) {
+      throw new SyntaxError('Brace AST exceeds maximum safe nesting or node count');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      if (visited + pending.length + node.nodes.length > 20000) {
+        throw new SyntaxError('Brace AST exceeds maximum safe nesting or node count');
+      }
+      for (const child of node.nodes) {
+        pending.push({ node: child, depth: depth + 1 });
+      }
+    }
+  }
+};
