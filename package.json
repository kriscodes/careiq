{
  "name": "@careiq/root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter ./apps/api --filter ./apps/web --filter ./apps/marketing --parallel dev",
    "lint": "pnpm lint:shared && pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "local:setup": "python3 scripts/local-review.py setup",
    "local:start": "python3 scripts/local-review.py start",
    "local:status": "python3 scripts/local-review.py status",
    "local:stop": "python3 scripts/local-review.py stop",
    "security:regressions": "node --test scripts/tests/security-dependencies.test.mjs && python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "security:audit": "pnpm audit --prod",
    "release:check": "node -e \"try { const url = new URL(process.env.TEST_DATABASE_URL || ''); if (!['postgres:', 'postgresql:'].includes(url.protocol) || !['localhost', '127.0.0.1', '[::1]'].includes(url.hostname) || url.pathname !== '/careiq_test' || url.search || url.hash) throw new Error(); } catch { console.error('Set TEST_DATABASE_URL to an isolated loopback PostgreSQL careiq_test database before release checks.'); process.exit(1); }\" && pnpm format:check && pnpm repo:check && pnpm lint && pnpm typecheck && pnpm test:quality && pnpm test:coverage && pnpm coverage:changed && pnpm test:managed-owner && pnpm security:regressions && pnpm web:associations:test && pnpm --fail-if-no-match --filter ./apps/web test:browser && pnpm test:browser:api && pnpm security:audit",
    "web:associations": "node scripts/generate-mobile-associations.mjs",
    "web:associations:check": "node scripts/generate-mobile-associations.mjs --check",
    "web:associations:test": "node --test scripts/tests/mobile-associations.test.mjs",
    "test:browser:api": "CAREIQ_REAL_API_E2E=true pnpm --fail-if-no-match --filter ./apps/web exec playwright test --config playwright.integration.config.ts",
    "lint:shared": "eslint packages scripts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:api": "eslint apps/api --max-warnings 0",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:quality": "node --test scripts/tests/*.test.mjs",
    "repo:check": "node scripts/check-repository.mjs",
    "coverage:changed": "node scripts/changed-coverage.mjs",
    "test:managed-owner": "node scripts/test-managed-owner.mjs",
    "release:metadata": "node scripts/release-metadata.mjs web marketing",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:verify-checks": "node scripts/verify-deployment-checks.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": "11.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "c8": "12.0.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
