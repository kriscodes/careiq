
### `.gitignore`

```gitignore
# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# TypeScript
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Temporary files
.tmp/
temp/
.cache/